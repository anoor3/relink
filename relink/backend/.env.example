# Copy to `backend/.env` (this file should not be committed)

# OpenAI (Whisper + agents)
OPENAI_API_KEY=
RELINK_WHISPER_MODEL=whisper-1
RELINK_OPENAI_AGENT_MODEL=gpt-4o-mini

# Anthropic (optional - if you decide to switch agents to Claude)
ANTHROPIC_API_KEY=
RELINK_CLAUDE_MODEL=claude-sonnet-4-20250514

# Nozomio / Nia (optional - integration scaffolded)
NIA_API_KEY=

# AgentMail (optional - integration scaffolded)
AGENTMAIL_API_KEY=

# Storage
# RELINK_DB_PATH=/absolute/or/relative/path/to/relink.sqlite

